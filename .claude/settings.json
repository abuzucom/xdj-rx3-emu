{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py",
              "--client",
              "claude"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_branch_name.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_git_identity.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/require_consent.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_branch_name.py",
              "--client",
              "claude"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_branch_name.py",
              "--client",
              "claude"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "Explore|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_branch_name.py",
              "--client",
              "claude"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Explore|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "0"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "1"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "2"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "3"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "4"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "5"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "6"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/hooks/reinject_agents_policy.py", "--client", "claude", "--chunk-index", "7"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_gate_adoption.py",
              "--client",
              "claude"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_branch_name.py",
              "--client",
              "claude"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/block_infrastructure_access.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/block_destructive_bash.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/enforce_git_identity.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/require_consent.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/block_destructive_powershell.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Cmd|CMD|CommandPrompt",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/hooks/block_destructive_cmd.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}

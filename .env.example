# Local environment configuration for rx3_windows.py.
# Copy this file to .env, set values, and load it before running rx3.cmd.
# This file intentionally contains no real paths or secrets.

# Virtual USB1 source folder on Windows.
# Use an absolute path. Leave blank or omit to disable USB1 sync.
# Quote the value if the path contains spaces.
RX3_USB1_SOURCE=

# Optional. If set, RX3_USB1_SOURCE must resolve under this folder.
RX3_USB1_ALLOWED_ROOT=
